# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Database (defaults to SQLite, switch to PostgreSQL for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/gmail_agent
DATABASE_URL=sqlite:///./gmail_agent.db

# App settings
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_random_secret_string
